# Vercel Marketplace PostgreSQL (Neon, Supabase, Aurora 등)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Vercel Blob image storage (injected automatically after connecting a Blob store)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE

# 관리자 계정
ADMIN_USERNAME=ROOT
ADMIN_PASSWORD=ROOT

# 32자 이상의 임의 문자열. 운영 환경마다 서로 다른 값을 사용하세요.
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# 선택 사항: Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-REPLACE_ME
