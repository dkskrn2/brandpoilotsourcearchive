BRAND_PILOT_API_URL=https://api.danbammsg.co.kr
WORKER_API_TOKEN=required-at-deploy-time
BLOB_READ_WRITE_TOKEN=required-at-deploy-time
IMAGE_PROVIDER=command
IMAGE_RENDER_COMMAND=node /app/workers/brand-pilot-image-worker/scripts/run-codex-image-render.mjs --job "{{jobFile}}" --output "{{outputDir}}" --workspace "{{workspaceDir}}"
IMAGE_JOB_TIMEOUT_MS=1200000
IMAGE_MODEL=codex-imagegen
IMAGE_RETRY_DELAY_MS=300000
POLL_INTERVAL_MS=10000
HEARTBEAT_INTERVAL_MS=300000
WORKER_RESOURCE_POLL_INTERVAL_MS=1000
WORKER_RESOURCE_HEARTBEAT_INTERVAL_MS=15000
