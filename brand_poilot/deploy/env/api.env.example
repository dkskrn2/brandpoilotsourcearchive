# Production listener and fail-closed HTTP policy.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://app.danbammsg.co.kr
DEV_AUTH_ENABLED=false
AUTH_FRONTEND_URL=https://app.danbammsg.co.kr

# Use SUPABASE_DATABASE_URL as the only production database URL.
# Alternative (do not enable alongside it): DATABASE_URL=required-at-deploy-time
SUPABASE_DATABASE_URL=required-at-deploy-time
# Mounted by Compose; the URL itself must not be copied into this env file.
AI_CONTENT_DATABASE_URL_FILE=/run/secrets/ai_content_application_database_url
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_SSL_CA_BASE64=

# Supabase storage.
SUPABASE_URL=required-at-deploy-time
SUPABASE_SERVICE_ROLE_KEY=required-at-deploy-time
SUPABASE_BRAND_ASSETS_BUCKET=brand-assets

# Internal API authentication and scheduling.
WORKER_API_TOKEN=required-at-deploy-time
CONTENT_PROPOSAL_WORKER_API_TOKEN=required-at-deploy-time
ADMIN_SERVICE_TOKEN=required-at-deploy-time
CRON_SECRET=required-at-deploy-time
# External OAuth 2.1 issuer used by the ChatGPT-connected content suggestion MCP resource.
CONTENT_SUGGESTION_OAUTH_ISSUER=https://oauth-provider.example.com/
CONTENT_SUGGESTION_OAUTH_JWKS_URI=https://oauth-provider.example.com/.well-known/jwks.json
CONTENT_SUGGESTION_OAUTH_AUDIENCE=authenticated
CONTENT_SUGGESTION_OAUTH_RESOURCE=https://api.danbammsg.co.kr/plugins/content-suggestions/mcp
# Comma-separated Supabase Auth subject UUIDs for dedicated scheduling operators.
CONTENT_SUGGESTION_OAUTH_ALLOWED_SUBJECTS=11111111-1111-4111-8111-111111111111
SOURCE_CRAWL_BATCH_SIZE=5
SOURCE_CRAWL_DISCOVERY_LIMIT=20
SOURCE_CRAWL_TIME_BUDGET_MS=45000
LOCAL_SCHEDULER_ENABLED=false
# Overridden explicitly per API service by compose.production.yml.
API_INSTANCE_ROLE=primary
AUTOMATED_CONTENT_ENABLED=false
CONTENT_PROPOSALS_ENABLED=true
DM_WORKERS_ENABLED=false
WORKER_CODEX_MAX_CONCURRENCY=2
WORKER_CODEX_DM_RESERVED_SLOTS=1

# FAQ expression generation and DM matching are activated per brand in stages.
FAQ_UTTERANCE_SUGGESTIONS_ENABLED=false
FAQ_EXPANDED_EXACT_ENABLED=false
FAQ_MATCH_SHADOW_ENABLED=false
FAQ_CLARIFICATION_ENABLED=false
FAQ_MATCH_BRAND_ALLOWLIST=
FAQ_CLARIFY_THRESHOLD=0.78
FAQ_CONFIRMATION_TTL_SECONDS=300

# Credential encryption and publication controls.
CREDENTIAL_ENCRYPTION_KEY=required-at-deploy-time
INSTAGRAM_PUBLISH_ENABLED=true
IMAGE_JOB_COOLDOWN_MS=60000

# Meta OAuth and webhook configuration.
META_GRAPH_VERSION=v23.0
# Parent Meta app credentials used by Facebook Login (Instagram trend search).
META_APP_ID=required-at-deploy-time
META_APP_SECRET=required-at-deploy-time
# Instagram Login product credentials used by Instagram OAuth and webhook signatures.
META_INSTAGRAM_APP_ID=required-at-deploy-time
META_INSTAGRAM_APP_SECRET=required-at-deploy-time
META_OAUTH_REDIRECT_URI=https://api.danbammsg.co.kr/auth/meta/callback
META_TRENDS_OAUTH_REDIRECT_URI=https://api.danbammsg.co.kr/auth/meta/trends/callback
# Provider console webhook URL (documentation only):
# https://api.danbammsg.co.kr/webhooks/meta/instagram
META_WEBHOOK_VERIFY_TOKEN=required-at-deploy-time
DM_PROFILE_REFRESH_AFTER_HOURS=24

# Kakao OAuth configuration.
KAKAO_REST_API_KEY=required-at-deploy-time
KAKAO_CLIENT_SECRET=required-at-deploy-time
KAKAO_REDIRECT_URI=https://api.danbammsg.co.kr/auth/kakao/callback

# Development identifiers remain inert because DEV_AUTH_ENABLED is false.
BRAND_PILOT_DEV_BRAND_ID=00000000-0000-4000-8000-000000000100
BRAND_PILOT_DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000001

# AI content upload and limits.
BLOB_READ_WRITE_TOKEN=required-at-deploy-time
AI_CONTENT_ATTACHMENT_UPLOAD_SESSIONS_ENABLED=true
AI_CONTENT_DAILY_GENERATION_LIMIT=10
AI_CONTENT_DAILY_DOWNLOAD_LIMIT=20
PUBLISH_ARTIFACT_ALLOWED_ORIGINS=
