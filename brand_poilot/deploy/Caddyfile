{
  servers {
    timeouts {
      read_body 30s
      read_header 10s
      write 60s
      idle 2m
    }
  }
}

{$CANARY_HOST} {
  tls {$ACME_EMAIL}
  encode zstd gzip
  request_body {
    max_size 32MB
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  reverse_proxy api-canary:4000 {
    health_uri /ready
    health_interval 10s
    health_timeout 3s
    transport http {
      dial_timeout 5s
      response_header_timeout 30s
    }
  }
}

{$PRIMARY_HOST} {
  tls {$ACME_EMAIL}
  encode zstd gzip
  request_body {
    max_size 32MB
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  reverse_proxy api-primary:4000 {
    health_uri /ready
    health_interval 10s
    health_timeout 3s
    transport http {
      dial_timeout 5s
      response_header_timeout 30s
    }
  }
}
