{
  "additionalProperties": false,
  "properties": {
    "capturedAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "contractVersion": {
      "const": "research-evidence.v1",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "const": "searched",
          "type": "string"
        },
        {
          "const": "not_needed",
          "type": "string"
        }
      ]
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capturedAt": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
            "type": "string"
          },
          "claimSummary": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "contentHash": {
            "pattern": "^[0-9a-fA-F]{64}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          "publishedAt": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "publisher": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "publishedAt",
          "capturedAt",
          "claimSummary",
          "contentHash"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "type": "array"
    },
    "queries": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "decision",
    "reason",
    "queries",
    "capturedAt",
    "items"
  ],
  "type": "object"
}
