{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "content", "imageDraft"],
  "properties": {
    "contractVersion": { "const": "blog-plan-draft.v1" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "htmlTemplate", "metaTitle", "metaDescription", "usedEvidenceIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "htmlTemplate": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "metaTitle": { "type": "string", "minLength": 1, "maxLength": 500 },
        "metaDescription": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "usedEvidenceIds": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "imageDraft": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["aspectRatio", "assets"],
          "properties": {
            "aspectRatio": { "enum": ["1:1", "4:5", "16:9", "9:16"] },
            "assets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/asset" }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "role", "copy", "visualDirection", "evidenceIds", "productImageAssetIds"],
      "properties": {
        "index": { "type": "integer", "minimum": 1, "maximum": 5 },
        "role": { "type": "string", "minLength": 1, "maxLength": 200 },
        "copy": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "visualDirection": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidenceIds": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/uuid" } },
        "productImageAssetIds": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/uuid" } }
      }
    }
  }
}
