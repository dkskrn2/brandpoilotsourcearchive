{
  "name": "@brand-pilot/dm-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @brand-pilot/worker-runtime",
    "dev": "tsx src/index.ts watch dm dm-worker-1",
    "predev:dm": "npm run build --workspace @brand-pilot/worker-runtime",
    "dev:dm": "tsx src/index.ts watch dm dm-worker-1",
    "predev:dm:1": "npm run build --workspace @brand-pilot/worker-runtime",
    "dev:dm:1": "tsx src/index.ts watch dm dm-worker-1",
    "predev:dm:2": "npm run build --workspace @brand-pilot/worker-runtime",
    "dev:dm:2": "tsx src/index.ts watch dm dm-worker-2",
    "predev:wiki": "npm run build --workspace @brand-pilot/worker-runtime",
    "dev:wiki": "tsx src/index.ts watch wiki wiki-worker-1",
    "preonce": "npm run build --workspace @brand-pilot/worker-runtime",
    "once": "tsx src/index.ts once dm dm-worker-once",
    "preonce:dm": "npm run build --workspace @brand-pilot/worker-runtime",
    "once:dm": "tsx src/index.ts once dm dm-worker-once",
    "preonce:wiki": "npm run build --workspace @brand-pilot/worker-runtime",
    "once:wiki": "tsx src/index.ts once wiki wiki-worker-once",
    "build": "npm run build --workspace @brand-pilot/worker-runtime && tsc --noEmit",
    "pretest": "npm run build --workspace @brand-pilot/worker-runtime",
    "test": "vitest run"
  },
  "dependencies": {
    "@brand-pilot/worker-runtime": "0.1.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
