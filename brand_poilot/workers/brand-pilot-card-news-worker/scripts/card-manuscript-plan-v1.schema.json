{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "content", "deckNarrative", "evidenceSelection", "scenes"],
  "properties": {
    "contractVersion": { "type": "string", "const": "card-manuscript-plan.v1" },
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["caption", "hashtags", "cta"],
      "properties": {
        "caption": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "hashtags": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "cta": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "deckNarrative": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "evidenceSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["selectedEvidenceIds", "excludedEvidenceIds"],
      "properties": {
        "selectedEvidenceIds": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/uuid" } },
        "excludedEvidenceIds": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "editorialRole", "purpose", "coreMessage", "headline", "informationRelation", "supportingTexts", "footnote", "evidenceIds", "productImageAssetIds", "avatarImageAssetIds"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 5 },
          "editorialRole": { "type": "string", "minLength": 1, "maxLength": 200 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
          "coreMessage": { "type": "string", "minLength": 1, "maxLength": 500 },
          "headline": { "type": "string", "minLength": 1, "maxLength": 300 },
          "informationRelation": {
            "type": "object", "additionalProperties": false, "required": ["type", "entries"],
            "properties": {
              "type": { "type": "string", "enum": ["none", "number", "before_after", "comparison", "steps", "quote", "related_facts"] },
              "entries": { "type": "array", "maxItems": 4, "items": {
                "type": "object", "additionalProperties": false, "required": ["role", "label", "value"],
                "properties": {
                  "role": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "label": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 100 }, { "type": "null" }] },
                  "value": { "type": "string", "minLength": 1, "maxLength": 300 }
                }
              } }
            }
          },
          "supportingTexts": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "footnote": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 300 }, { "type": "null" }] },
          "evidenceIds": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/uuid" } },
          "productImageAssetIds": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/uuid" } },
          "avatarImageAssetIds": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/uuid" } }
        }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" }
  }
}
