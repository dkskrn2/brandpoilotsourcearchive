{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "content", "assets"],
  "properties": {
    "contractVersion": { "type": "string", "const": "card-news-plan-draft.v1" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "hashtags", "cta"],
      "properties": {
        "caption": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "hashtags": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "cta": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "role", "copy", "visualDirection", "evidenceIds", "productImageAssetIds"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 5 },
          "role": { "type": "string", "minLength": 1, "maxLength": 200 },
          "copy": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "visualDirection": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "evidenceIds": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            }
          },
          "productImageAssetIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            }
          }
        }
      }
    }
  }
}
