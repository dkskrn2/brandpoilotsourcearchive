{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "content", "deckNarrative", "visualSystem", "scenes"],
  "properties": {
    "contractVersion": { "type": "string", "const": "card-deck-editorial-plan.v1" },
    "content": {
      "type": "object", "additionalProperties": false,
      "required": ["caption", "hashtags", "cta"],
      "properties": {
        "caption": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "hashtags": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "cta": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "deckNarrative": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "visualSystem": {
      "type": "object", "additionalProperties": false,
      "required": ["paletteDirection", "typographyDirection", "graphicLanguage", "imageryDirection", "invariants"],
      "properties": {
        "paletteDirection": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "typographyDirection": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "graphicLanguage": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "imageryDirection": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "invariants": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "scenes": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "editorialRole", "purpose", "coreMessage", "headline", "keyVisual", "supportingTexts", "footnote", "visualThesis", "layoutArchetype", "evidenceIds", "productImageAssetIds"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 5 },
          "editorialRole": { "type": "string", "minLength": 1, "maxLength": 200 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
          "coreMessage": { "type": "string", "minLength": 1, "maxLength": 500 },
          "headline": { "type": "string", "minLength": 1, "maxLength": 300 },
          "keyVisual": {
            "type": "object", "additionalProperties": false, "required": ["type", "entries"],
            "properties": {
              "type": { "type": "string", "enum": ["none", "number", "before_after", "comparison", "steps", "quote"] },
              "entries": { "type": "array", "maxItems": 4, "items": {
                "type": "object", "additionalProperties": false, "required": ["role", "label", "value"],
                "properties": {
                  "role": { "type": "string", "enum": ["value", "before", "after", "left", "right", "step", "quote", "attribution"] },
                  "label": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 100 }, { "type": "null" }] },
                  "value": { "type": "string", "minLength": 1, "maxLength": 300 }
                }
              } }
            }
          },
          "supportingTexts": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "footnote": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 300 }, { "type": "null" }] },
          "visualThesis": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "layoutArchetype": { "type": "string", "enum": ["cover_editorial", "stat_focus", "before_after", "comparison", "sequence", "checklist", "quote", "editorial_freeform"] },
          "evidenceIds": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" } },
          "productImageAssetIds": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" } }
        }
      }
    }
  }
}
