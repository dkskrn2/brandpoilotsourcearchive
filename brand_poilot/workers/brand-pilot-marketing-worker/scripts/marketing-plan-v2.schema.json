{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "outputFormat", "content", "imagePackage"],
  "properties": {
    "contractVersion": { "const": "marketing-plan.v2" },
    "outputFormat": { "enum": ["reel", "marketing_content"] },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "hashtags", "cta"],
      "properties": {
        "caption": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "hashtags": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "cta": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "imagePackage": { "$ref": "#/$defs/imagePackage" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "ownedImage": {
      "type": "object", "additionalProperties": false,
      "required": ["storageUrl", "storagePath", "mimeType", "checksum"],
      "properties": {
        "storageUrl": { "type": "string", "minLength": 1 },
        "storagePath": { "type": "string", "minLength": 1 },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "productImage": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "role", "storageUrl", "storagePath", "mimeType", "checksum"],
      "properties": {
        "assetId": { "$ref": "#/$defs/uuid" },
        "role": { "enum": ["hero", "detail"] },
        "storageUrl": { "type": "string", "minLength": 1 },
        "storagePath": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "versionId", "kind", "name", "description", "features", "benefits", "cautions", "evergreenPurchaseInfo", "images"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "versionId": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["product", "service"] },
        "name": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
        "benefits": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
        "cautions": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
        "evergreenPurchaseInfo": { "type": "string", "minLength": 1 },
        "images": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/productImage" } }
      }
    },
    "referenceImage": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ownedImage" }
      ]
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceItemId", "snapshotId", "roles", "title", "sourceUrl", "capturedAt", "contentHash", "text", "image"],
      "properties": {
        "referenceItemId": { "$ref": "#/$defs/uuid" }, "snapshotId": { "$ref": "#/$defs/uuid" },
        "roles": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["planning", "copy_pattern", "visual_composition"] } },
        "title": { "type": "string", "minLength": 1 }, "sourceUrl": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "minLength": 1 }, "contentHash": { "$ref": "#/$defs/sha256" },
        "text": { "type": "string", "minLength": 1 }, "image": { "$ref": "#/$defs/referenceImage" }
      }
    },
    "styleImage": {
      "type": "object", "additionalProperties": false,
      "required": ["referenceItemId", "description", "tags", "storageUrl", "storagePath", "mimeType", "checksum"],
      "properties": {
        "referenceItemId": { "$ref": "#/$defs/uuid" }, "description": { "type": "string", "maxLength": 4000 },
        "tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "storageUrl": { "type": "string", "minLength": 1 }, "storagePath": { "type": "string", "minLength": 1 },
        "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] }, "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "fileName", "mimeType", "sizeBytes", "checksum", "storageUrl", "storagePath"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "role": { "enum": ["product_image", "visual_reference", "supporting_image"] },
        "fileName": { "type": "string", "minLength": 1 }, "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
        "sizeBytes": { "type": "integer", "minimum": 1 }, "checksum": { "$ref": "#/$defs/sha256" },
        "storageUrl": { "type": "string", "minLength": 1 }, "storagePath": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "role", "copy", "visualDirection", "evidenceIds", "productImageAssetIds", "attachmentIds"],
      "properties": {
        "index": { "type": "integer", "minimum": 1, "maximum": 5 }, "role": { "type": "string", "minLength": 1 },
        "copy": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "visualDirection": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidenceIds": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "productImageAssetIds": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "attachmentIds": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "logoPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowGeneratedLogo", "allowReservedLogoArea", "allowExternalReferenceLogo", "allowExistingProductPackagingLogo"],
      "properties": {
        "allowGeneratedLogo": { "const": false }, "allowReservedLogoArea": { "const": false },
        "allowExternalReferenceLogo": { "const": false }, "allowExistingProductPackagingLogo": { "const": true }
      }
    },
    "imagePackage": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "generationId", "outputFormat", "purpose", "assetCount", "aspectRatio", "channelTargets", "assets", "product", "references", "brandStyleImages", "avatarStyleImageId", "attachments", "userImageInstruction", "logoPolicy"],
      "properties": {
        "contractVersion": { "const": "image-generation-package.v1" }, "generationId": { "$ref": "#/$defs/uuid" },
        "outputFormat": { "enum": ["reel", "marketing_content"] }, "purpose": { "enum": ["informational", "marketing"] },
        "assetCount": { "type": "integer", "minimum": 1, "maximum": 5 }, "aspectRatio": { "enum": ["1:1", "4:5", "16:9", "9:16"] },
        "channelTargets": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "enum": ["instagram", "threads", "x", "linkedin", "youtube", "tiktok"] } },
        "assets": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/asset" } },
        "product": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/product" }] },
        "references": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/reference" } },
        "brandStyleImages": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/styleImage" } },
        "avatarStyleImageId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }] },
        "attachments": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/attachment" } },
        "userImageInstruction": { "type": ["string", "null"], "maxLength": 4000 },
        "logoPolicy": { "$ref": "#/$defs/logoPolicy" }
      }
    }
  }
}
