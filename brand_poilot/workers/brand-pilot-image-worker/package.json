{
  "name": "@brand-pilot/image-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @brand-pilot/worker-runtime",
    "dev": "tsx src/index.ts watch",
    "prerun-once": "npm run build --workspace @brand-pilot/worker-runtime",
    "run-once": "tsx src/index.ts run-once",
    "control": "tsx src/control/index.ts",
    "build": "npm run build --workspace @brand-pilot/worker-runtime && tsc -p tsconfig.build.json",
    "start": "node dist/index.js watch",
    "pretest": "npm run build --workspace @brand-pilot/worker-runtime",
    "test": "vitest run",
    "verify:reel": "node scripts/verify-reel.mjs"
  },
  "dependencies": {
    "@brand-pilot/content-contracts": "0.1.0",
    "@brand-pilot/worker-runtime": "0.1.0",
    "@vercel/blob": "^2.6.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "ipaddr.js": "^2.4.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
