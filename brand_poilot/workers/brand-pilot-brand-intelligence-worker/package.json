{
  "name": "@brand-pilot/brand-intelligence-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @brand-pilot/worker-runtime",
    "dev": "tsx src/index.ts watch",
    "prerun-once": "npm run build --workspace @brand-pilot/worker-runtime",
    "run-once": "tsx src/index.ts once",
    "build": "npm run build --workspace @brand-pilot/worker-runtime && tsc -p tsconfig.json",
    "pretest": "npm run build --workspace @brand-pilot/worker-runtime",
    "test": "vitest run"
  },
  "dependencies": {
    "@brand-pilot/worker-runtime": "0.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.55.1",
    "tldts": "^6.1.86",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
